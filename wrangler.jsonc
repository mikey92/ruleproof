{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruleproof",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Readings by fingerprint of the rules text, so the same rules are read by the AI once.
  "kv_namespaces": [{ "binding": "READINGS", "id": "ruleproof-readings-local" }],
  // Per visitor IP: keeps one browser from spending the reader's capacity.
  "ratelimits": [{ "name": "READ_LIMIT", "namespace_id": "4201", "simple": { "limit": 6, "period": 60 } }],
  "observability": { "enabled": true }
  // Secrets: LLM_RELAY_URL and LLM_RELAY_KEY, or OPENAI_API_KEY. Optional var: LLM_MODEL.
}
